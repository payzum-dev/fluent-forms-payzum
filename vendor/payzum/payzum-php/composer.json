{
  "name": "payzum/payzum-php",
  "description": "Official PHP SDK for the Payzum crypto payment API — accept stablecoin and crypto payments, verify IPN webhooks.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://merchant.payzum.com",
  "keywords": [
    "payzum",
    "payments",
    "crypto",
    "stablecoin",
    "usdt",
    "usdc",
    "payment-gateway",
    "bitcoin",
    "ethereum"
  ],
  "authors": [
    {
      "name": "Payzum",
      "homepage": "https://payzum.com"
    }
  ],
  "support": {
    "docs": "https://merchant.payzum.com/docs",
    "issues": "https://github.com/payzum-dev/payzum-php/issues",
    "source": "https://github.com/payzum-dev/payzum-php"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*"
  },
  "autoload": {
    "psr-4": {
      "Payzum\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Payzum\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": [
      "@composer dump-autoload --dev --quiet",
      "php tests/run.php"
    ]
  },
  "scripts-descriptions": {
    "test": "Run the suite. Needs no network and no dev dependencies."
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
